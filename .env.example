# Application Settings
SPRING_PROFILES_ACTIVE=dev
SPRING_PORT=8080
BFF_CONTEXT_PATH=/api

# Database Settings (BFF App)
APP_DB_HOST=localhost
APP_DB_PORT=5433
APP_DB_NAME=bff_app
APP_DB_USER=bff
APP_DB_PASSWORD=change_me

# Keycloak Database Settings
KC_DB_PORT=5434
KC_DB_NAME=keycloak
KC_DB_USER=kc
KC_DB_PASSWORD=change_me

# Keycloak Settings
KC_PORT=8081
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KC_ADMIN_CLIENT_ID=admin-cli
KC_REALM=bff-realm
KC_CLIENT_ID=bff-client
KC_CLIENT_SECRET=change_me

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# Session Settings
SESSION_COOKIE_NAME=SESSION_ID
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

# Google OAuth Credentials (Used in Keycloak)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend Settings
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000/dashboard
